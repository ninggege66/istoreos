#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99
STOP=10

NAME=modemwebui
CACHE_FILE=/etc/modemwebui/device.cache

# 检测 PCIe 模组
detect_pcie_modem() {
    for dev in /sys/bus/pci/devices/*/; do
        vendor=$(cat "$dev/vendor" 2>/dev/null)
        device=$(cat "$dev/device" 2>/dev/null)
        case "$vendor:$device" in
            0x14c3:0x4d75) return 0 ;;  # FM350-GL / T700
        esac
    done
    return 1
}

# 检测 USB 模组
detect_usb_modem() {
    lsusb 2>/dev/null | grep -qE "MT5700M-CN|0e8d:7127|FM350-GL|RM500Q|RM502Q|RM551E|RM520F|RM521F|RG501Q|RG520F|RM510Q|RM520N"
}

# 检测是 MT5700M-CN（用 webui5700）还是其他（用 webui000）
detect_mt5700() {
    lsusb 2>/dev/null | grep -q "MT5700M-CN"
}

# 获取 webui 配置文件路径（优先读缓存）
get_config_file() {
    if [ -f "$CACHE_FILE" ]; then
        cat "$CACHE_FILE"
        return
    fi
    # 无缓存时默认用 webui000
    echo "/www/webui/webui000/web/config.json"
}

# 扫描模组并写缓存（供自动拨号开启时调用）
scan_and_cache() {
    local cfg="/www/webui/webui000/web/config.json"

    if detect_pcie_modem || detect_usb_modem; then
        detect_mt5700 && cfg="/www/webui/webui5700/web/config.json"
    fi

    mkdir -p "$(dirname "$CACHE_FILE")"
    echo "$cfg" > "$CACHE_FILE"
    echo "$cfg"
}

start_service_instance() {
    local CONFIG_FILE=$1

    # 执行欺骗脚本
    /etc/modemwebui/spoof-board.sh

    LAN_ADDR=$(uci -q get network.lan.ipaddr 2>/dev/null)
    LAN_ADDR=${LAN_ADDR:-192.168.1.1}

    # 还原并替换 IP
    cp -f "${CONFIG_FILE}.bak" "$CONFIG_FILE" 2>/dev/null
    ESCAPED_ADDR=$(echo "$LAN_ADDR" | sed 's/\./\\./g')
    sed -i "s/192\.168\.1\.1/$ESCAPED_ADDR/g" "$CONFIG_FILE"

    # 实例1: 真正的 WebUI 服务
    procd_open_instance "main"
    procd_set_param command /bin/sh -c "cd '$(dirname "$CONFIG_FILE")/../' && exec '/usr/bin/webuiserver'"
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_service() {
    local CONFIG_FILE
    [ -f "$CACHE_FILE" ] && CONFIG_FILE=$(cat "$CACHE_FILE")
    CONFIG_FILE=${CONFIG_FILE:-/www/webui/webui000/web/config.json}

    # 实例2: 守护进程（心跳监控）
    procd_open_instance "watchdog"
    procd_set_param command /bin/sh -c "
        while true; do
            if [ -f /tmp/modemwebui.heartbeat ]; then
                last=\$(stat -c %Y /tmp/modemwebui.heartbeat)
                now=\$(date +%s)
                if [ \$((now - last)) -gt 25 ]; then
                    # 停止 WebUI 实例以释放端口
                    ubus call service delete '{\"name\":\"modemwebui\", \"instance\":\"main\"}'
                    rm -f /tmp/modemwebui.heartbeat
                fi
            fi
            sleep 10
        done
    "
    procd_close_instance

    # 注意：这里不主动调用 start_service_instance，
    # 由 LuCI 的 action_heartbeat 在需要时调用 start。
}

stop_service() {
    # 彻底停止所有实例
    return 0
}

# 供外部调用：重新启动 WebUI
start() {
    local CONFIG_FILE
    [ -f "$CACHE_FILE" ] && CONFIG_FILE=$(cat "$CACHE_FILE")
    CONFIG_FILE=${CONFIG_FILE:-/www/webui/webui000/web/config.json}
    start_service_instance "$CONFIG_FILE"
}

# 供外部调用：清除缓存并重新扫描
rescan() {
    rm -f "$CACHE_FILE"
    /etc/init.d/modemwebui restart
}
