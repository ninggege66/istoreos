#!/bin/sh

CFG=libernet-fan
STATE=/tmp/libernet-fan.state
CPU_STATE=/tmp/libernet-fan.cpu

find_fan_pwm() {
	for h in /sys/class/hwmon/hwmon*; do
		if [ "$(cat "$h/name" 2>/dev/null)" = "pwmfan" ]; then
			if [ -f "$h/pwm1" ]; then
				echo "$h/pwm1"
				return 0
			fi
		fi
	done
	# Fallback to cooling device
	for c in /sys/class/thermal/cooling_device*; do
		if [ "$(cat "$c/type" 2>/dev/null)" = "pwm-fan" ]; then
			echo "$c/cur_state"
			return 0
		fi
	done
	return 1
}

fan_max_val() {
	target="$1"
	case "$target" in
		*cur_state)
			cdev="${target%/cur_state}"
			max="$(cat "$cdev/max_state" 2>/dev/null)"
			[ -z "$max" ] && max=255
			echo "$max"
			;;
		*)
			echo 255
			;;
	esac
}

disable_kernel_thermal() {
	for z in /sys/class/thermal/thermal_zone*; do
		[ -f "$z/policy" ] || continue
		echo "user_space" > "$z/policy" 2>/dev/null
	done
	for h in /sys/class/hwmon/hwmon*; do
		if [ "$(cat "$h/name" 2>/dev/null)" = "pwmfan" ]; then
			[ -f "$h/pwm1_enable" ] && echo 1 > "$h/pwm1_enable" 2>/dev/null
		fi
	done
}

set_pwm() {
	pct="$1"
	[ -n "$pct" ] || pct=0
	[ "$pct" -lt 0 ] 2>/dev/null && pct=0
	[ "$pct" -gt 100 ] 2>/dev/null && pct=100
	
	target="$(find_fan_pwm)" || return 1
	max="$(fan_max_val "$target")"
	
	# Inverted polarity: 100% = 0, 0% = max
	val=$((max - (max * pct / 100)))
	[ "$val" -lt 0 ] && val=0
	[ "$val" -gt "$max" ] && val="$max"
	
	disable_kernel_thermal
	echo "$val" > "$target" 2>/dev/null || return 1
	echo "$pct" > "$STATE"
}

read_temp() {
	for z in /sys/class/thermal/thermal_zone*; do
		[ -f "$z/temp" ] || continue
		t=$(cat "$z/temp" 2>/dev/null)
		case "$t" in
			''|*[!0-9]*) continue ;;
		esac
		if [ "$t" -gt 1000 ]; then
			echo $((t / 1000))
		else
			echo "$t"
		fi
		return
	done
	echo 0
}

calc_smart_pwm() {
	temp="$1"
	target="$2"
	minp="$3"
	maxp="$4"
	kp="$5"
	step="$6"
	cur="$7"

	[ -z "$target" ] && target=50
	[ -z "$minp" ] && minp=20
	[ -z "$maxp" ] && maxp=100
	[ -z "$kp" ] && kp=3
	[ -z "$step" ] && step=4
	[ -z "$cur" ] && cur=$minp

	delta=$((temp - target))
	desired=$((minp + delta * kp))
	[ "$desired" -lt "$minp" ] && desired=$minp
	[ "$desired" -gt "$maxp" ] && desired=$maxp

	if [ "$desired" -gt "$cur" ]; then
		next=$((cur + step))
		[ "$next" -gt "$desired" ] && next=$desired
	else
		next=$((cur - step))
		[ "$next" -lt "$desired" ] && next=$desired
	fi
	echo "$next"
}

disable_kernel_thermal

while true; do
	enabled="$(uci -q get ${CFG}.main.enabled 2>/dev/null || echo 1)"
	mode="$(uci -q get ${CFG}.main.mode 2>/dev/null || echo smart)"
	interval="$(uci -q get ${CFG}.main.interval 2>/dev/null || echo 2)"
	[ -z "$interval" ] && interval=2
	[ "$interval" -lt 1 ] 2>/dev/null && interval=1

	if [ "$enabled" != "1" ]; then
		set_pwm 0
		sleep "$interval"
		continue
	fi

	case "$mode" in
		silent)
			set_pwm "$(uci -q get ${CFG}.main.silent_pwm 2>/dev/null || echo 20)"
			;;
		turbo)
			set_pwm "$(uci -q get ${CFG}.main.turbo_pwm 2>/dev/null || echo 100)"
			;;
		manual)
			set_pwm "$(uci -q get ${CFG}.main.manual_pwm 2>/dev/null || echo 35)"
			;;
		smart|*)
			temp="$(read_temp)"
			cur="$(cat "$STATE" 2>/dev/null || uci -q get ${CFG}.main.silent_pwm 2>/dev/null || echo 20)"
			next="$(calc_smart_pwm \
				"$temp" \
				"$(uci -q get ${CFG}.main.smart_target_temp 2>/dev/null || echo 50)" \
				"$(uci -q get ${CFG}.main.smart_min_pwm 2>/dev/null || echo 15)" \
				"$(uci -q get ${CFG}.main.smart_max_pwm 2>/dev/null || echo 100)" \
				"$(uci -q get ${CFG}.main.smart_kp 2>/dev/null || echo 3)" \
				"$(uci -q get ${CFG}.main.smooth_step 2>/dev/null || echo 4)" \
				"$cur")"
			set_pwm "$next"
			;;
	esac

	sleep "$interval"
done
